<mxfile host="app.diagrams.net">
  <diagram name="Agents + MCP Architecture" id="agents-mcp-architecture">
    <mxGraphModel dx="1160" dy="570" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1160" pageHeight="400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="col-agents-label" value="Banking Agents" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=12;fontColor=#64748b;" vertex="1" parent="1">
          <mxGeometry x="45" y="15" width="915" height="22" as="geometry" />
        </mxCell>
        <mxCell id="col-mcp-label" value="MCP Backends" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=12;fontColor=#64748b;" vertex="1" parent="1">
          <mxGeometry x="945" y="120" width="180" height="22" as="geometry" />
        </mxCell>

        <mxCell id="you" value="You" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#64748b;fontColor=#0f172a;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="229" width="90" height="45" as="geometry" />
        </mxCell>

        <mxCell id="accounts" value="Accounts Agent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e3a8a;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="45" y="45" width="165" height="52" as="geometry" />
        </mxCell>
        <mxCell id="orchestrator" value="Transfer Orchestrator Agent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#4c1d95;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="255" y="45" width="180" height="52" as="geometry" />
        </mxCell>
        <mxCell id="settlement" value="Settlement Agent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#7c2d12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="525" y="45" width="165" height="52" as="geometry" />
        </mxCell>
        <mxCell id="statements" value="Statements Agent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#0d9488;fontColor=#134e4a;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="795" y="45" width="165" height="52" as="geometry" />
        </mxCell>

        <mxCell id="agw" value="agentgateway&#10;routing &#183; auth &#183; guardrails &#183; cost" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4f46e5;strokeColor=#3730a3;fontColor=#ffffff;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="165" y="210" width="750" height="82" as="geometry" />
        </mxCell>

        <mxCell id="corebanking" value="Core Banking MCP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d1fae5;strokeColor=#059669;fontColor=#064e3b;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="945" y="160" width="180" height="52" as="geometry" />
        </mxCell>
        <mxCell id="paypal" value="PayPal MCP (sandbox)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#ca8a04;fontColor=#713f12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="945" y="225" width="180" height="52" as="geometry" />
        </mxCell>
        <mxCell id="stripe" value="Stripe MCP (sandbox)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0e7ff;strokeColor=#4f46e5;fontColor=#312e81;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="945" y="290" width="180" height="52" as="geometry" />
        </mxCell>

        <!-- You initiates - the only edge that isn't also a round trip -->
        <mxCell id="e-you-agw" style="edgeStyle=none;curved=0;rounded=0;html=1;strokeColor=#64748b;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="you" target="agw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Every agent's traffic - inbound calls and outbound MCP tool calls alike - flows through agentgateway, so each connection is a single round-trip line, not a bypass -->
        <mxCell id="e-agw-accounts" style="edgeStyle=none;curved=0;rounded=0;html=1;strokeColor=#2563eb;startArrow=classic;startFill=1;endArrow=classic;endFill=1;exitX=-0.05;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="agw" target="accounts">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-agw-orchestrator" style="edgeStyle=none;curved=0;rounded=0;html=1;strokeColor=#7c3aed;startArrow=classic;startFill=1;endArrow=classic;endFill=1;exitX=0.24;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="agw" target="orchestrator">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-agw-settlement" style="edgeStyle=none;curved=0;rounded=0;html=1;strokeColor=#ea580c;startArrow=classic;startFill=1;endArrow=classic;endFill=1;exitX=0.59;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="agw" target="settlement">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-agw-statements" style="edgeStyle=none;curved=0;rounded=0;html=1;strokeColor=#0d9488;startArrow=classic;startFill=1;endArrow=classic;endFill=1;exitX=0.95;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="agw" target="statements">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Logical delegation relationship only - the actual call is Orchestrator -> agentgateway -> Settlement, the two edges above -->
        <mxCell id="e-orchestrator-settlement" value="delegates" style="edgeStyle=none;curved=0;rounded=0;dashed=1;html=1;strokeColor=#94a3b8;fontSize=10;fontColor=#64748b;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="orchestrator" target="settlement">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e-agw-corebanking" style="edgeStyle=none;curved=0;rounded=0;html=1;strokeColor=#059669;exitX=1;exitY=0.1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="agw" target="corebanking">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-agw-paypal" style="edgeStyle=none;curved=0;rounded=0;html=1;strokeColor=#ca8a04;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="agw" target="paypal">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-agw-stripe" style="edgeStyle=none;curved=0;rounded=0;html=1;strokeColor=#4f46e5;exitX=1;exitY=0.9;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="agw" target="stripe">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
