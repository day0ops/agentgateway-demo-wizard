apiVersion: v1
kind: Secret
metadata:
  name: routing-by-name-openai-secret
  namespace: {{ .Namespace }}
  labels:
    app.kubernetes.io/managed-by: agentgateway-demo-wizard
type: Opaque
stringData:
  Authorization: {{ .OpenAIKey }}
---
apiVersion: v1
kind: Secret
metadata:
  name: routing-by-name-anthropic-secret
  namespace: {{ .Namespace }}
  labels:
    app.kubernetes.io/managed-by: agentgateway-demo-wizard
type: Opaque
stringData:
  Authorization: {{ .AnthropicKey }}
---
apiVersion: enterpriseagentgateway.solo.io/v1alpha1
kind: EnterpriseAgentgatewayBackend
metadata:
  name: routing-by-name-openai
  namespace: {{ .Namespace }}
  labels:
    app.kubernetes.io/managed-by: agentgateway-demo-wizard
spec:
  ai:
    provider:
      openai:
        model: gpt-4o-mini
  policies:
    auth:
      secretRef:
        name: routing-by-name-openai-secret
---
apiVersion: enterpriseagentgateway.solo.io/v1alpha1
kind: EnterpriseAgentgatewayBackend
metadata:
  name: routing-by-name-anthropic
  namespace: {{ .Namespace }}
  labels:
    app.kubernetes.io/managed-by: agentgateway-demo-wizard
spec:
  ai:
    provider:
      anthropic:
        model: claude-3-5-sonnet-20241022
  policies:
    auth:
      secretRef:
        name: routing-by-name-anthropic-secret
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: routing-by-name
  namespace: {{ .Namespace }}
  labels:
    app.kubernetes.io/managed-by: agentgateway-demo-wizard
spec:
  parentRefs:
    - name: {{ .GatewayName }}
      namespace: {{ .GatewayNS }}
  rules:
    - matches:
        - path:
            type: PathPrefix
            value: /chat/by-name
          headers:
            - name: X-Demo-Model
              value: gpt-4o-mini
      backendRefs:
        - name: routing-by-name-openai
          namespace: {{ .Namespace }}
          group: enterpriseagentgateway.solo.io
          kind: EnterpriseAgentgatewayBackend
    - matches:
        - path:
            type: PathPrefix
            value: /chat/by-name
          headers:
            - name: X-Demo-Model
              value: claude-3-5-sonnet-20241022
      backendRefs:
        - name: routing-by-name-anthropic
          namespace: {{ .Namespace }}
          group: enterpriseagentgateway.solo.io
          kind: EnterpriseAgentgatewayBackend
