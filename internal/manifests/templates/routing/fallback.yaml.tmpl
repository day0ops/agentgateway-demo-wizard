apiVersion: v1
kind: Secret
metadata:
  name: routing-fallback-openai-secret
  namespace: {{ .Namespace }}
  labels:
    app.kubernetes.io/managed-by: agentgateway-demo-wizard
type: Opaque
stringData:
  Authorization: {{ .OpenAIKey }}
---
apiVersion: enterpriseagentgateway.solo.io/v1alpha1
kind: EnterpriseAgentgatewayBackend
metadata:
  name: routing-fallback
  namespace: {{ .Namespace }}
  labels:
    app.kubernetes.io/managed-by: agentgateway-demo-wizard
spec:
  ai:
    groups:
      - providers:
          - name: routing-fallback-cheap
            openai:
              model: gpt-4o-mini
            policies:
              auth:
                secretRef:
                  name: routing-fallback-openai-secret
      - providers:
          - name: routing-fallback-premium
            openai:
              model: gpt-4o
            policies:
              auth:
                secretRef:
                  name: routing-fallback-openai-secret
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: routing-fallback
  namespace: {{ .Namespace }}
  labels:
    app.kubernetes.io/managed-by: agentgateway-demo-wizard
spec:
  parentRefs:
    - name: {{ .GatewayName }}
      namespace: {{ .GatewayNS }}
  rules:
    - matches:
        - path:
            type: PathPrefix
            value: /chat/fallback
      backendRefs:
        - name: routing-fallback
          namespace: {{ .Namespace }}
          group: enterpriseagentgateway.solo.io
          kind: EnterpriseAgentgatewayBackend
