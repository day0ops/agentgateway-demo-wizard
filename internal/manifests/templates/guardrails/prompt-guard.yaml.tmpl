apiVersion: v1
kind: Secret
metadata:
  name: guardrails-openai-secret
  namespace: {{ .Namespace }}
  labels:
    app.kubernetes.io/managed-by: agentgateway-demo-wizard
type: Opaque
stringData:
  Authorization: {{ .OpenAIKey }}
---
apiVersion: enterpriseagentgateway.solo.io/v1alpha1
kind: EnterpriseAgentgatewayBackend
metadata:
  name: guardrails-openai
  namespace: {{ .Namespace }}
  labels:
    app.kubernetes.io/managed-by: agentgateway-demo-wizard
spec:
  ai:
    provider:
      openai:
        model: gpt-4o-mini
  policies:
    auth:
      secretRef:
        name: guardrails-openai-secret
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: guardrails-openai
  namespace: {{ .Namespace }}
  labels:
    app.kubernetes.io/managed-by: agentgateway-demo-wizard
spec:
  parentRefs:
    - name: {{ .GatewayName }}
      namespace: {{ .GatewayNS }}
  rules:
    - matches:
        - path:
            type: PathPrefix
            value: /guardrails/openai
      backendRefs:
        - name: guardrails-openai
          namespace: {{ .Namespace }}
          group: enterpriseagentgateway.solo.io
          kind: EnterpriseAgentgatewayBackend
---
apiVersion: enterpriseagentgateway.solo.io/v1alpha1
kind: EnterpriseAgentgatewayPolicy
metadata:
  name: guardrails-prompt-guard
  namespace: {{ .Namespace }}
  labels:
    app.kubernetes.io/managed-by: agentgateway-demo-wizard
spec:
  targetRefs:
    - group: gateway.networking.k8s.io
      kind: HTTPRoute
      name: guardrails-openai
  backend:
    ai:
      promptGuard:
        request:
          - regex:
              action: Reject
              matches:
                - 'credit card'
              builtins:
                - Ssn
                - CreditCard
            response:
              message: 'Request rejected due to policy violation'
        response:
          - regex:
              action: Mask
              builtins:
                - Ssn
                - CreditCard
                - Email
