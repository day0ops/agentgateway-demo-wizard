apiVersion: v1
kind: ServiceAccount
metadata:
  name: agent-mcp-stock-server
  namespace: {{ .Namespace }}
  labels:
    app.kubernetes.io/managed-by: agentgateway-demo-wizard
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: agent-mcp-stock-server
  namespace: {{ .Namespace }}
  labels:
    app.kubernetes.io/managed-by: agentgateway-demo-wizard
    app: agent-mcp-stock-server
spec:
  replicas: 1
  selector:
    matchLabels:
      app: agent-mcp-stock-server
  template:
    metadata:
      labels:
        app: agent-mcp-stock-server
    spec:
      serviceAccountName: agent-mcp-stock-server
      containers:
        - name: server
          image: {{ .StockMCPImage }}
          imagePullPolicy: IfNotPresent
          ports:
            - containerPort: 8000
          resources:
            requests:
              cpu: 100m
              memory: 128Mi
            limits:
              cpu: 200m
              memory: 256Mi
---
apiVersion: v1
kind: Service
metadata:
  name: agent-mcp-stock-server
  namespace: {{ .Namespace }}
  labels:
    app.kubernetes.io/managed-by: agentgateway-demo-wizard
spec:
  selector:
    app: agent-mcp-stock-server
  ports:
    - port: 80
      targetPort: 8000
      appProtocol: kgateway.dev/mcp
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: agent-mcp-currency-server
  namespace: {{ .Namespace }}
  labels:
    app.kubernetes.io/managed-by: agentgateway-demo-wizard
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: agent-mcp-currency-server
  namespace: {{ .Namespace }}
  labels:
    app.kubernetes.io/managed-by: agentgateway-demo-wizard
    app: agent-mcp-currency-server
spec:
  replicas: 1
  selector:
    matchLabels:
      app: agent-mcp-currency-server
  template:
    metadata:
      labels:
        app: agent-mcp-currency-server
    spec:
      serviceAccountName: agent-mcp-currency-server
      containers:
        - name: server
          image: {{ .CurrencyMCPImage }}
          imagePullPolicy: IfNotPresent
          ports:
            - containerPort: 8000
          resources:
            requests:
              cpu: 100m
              memory: 128Mi
            limits:
              cpu: 200m
              memory: 256Mi
---
apiVersion: v1
kind: Service
metadata:
  name: agent-mcp-currency-server
  namespace: {{ .Namespace }}
  labels:
    app.kubernetes.io/managed-by: agentgateway-demo-wizard
spec:
  selector:
    app: agent-mcp-currency-server
  ports:
    - port: 80
      targetPort: 8000
      appProtocol: kgateway.dev/mcp
---
apiVersion: enterpriseagentgateway.solo.io/v1alpha1
kind: EnterpriseAgentgatewayBackend
metadata:
  name: agent-mcp-backend
  namespace: {{ .Namespace }}
  labels:
    app.kubernetes.io/managed-by: agentgateway-demo-wizard
spec:
  mcp:
    targets:
      - name: stock
        static:
          host: agent-mcp-stock-server.{{ .Namespace }}.svc.cluster.local
          port: 80
          protocol: StreamableHTTP
      - name: currency
        static:
          host: agent-mcp-currency-server.{{ .Namespace }}.svc.cluster.local
          port: 80
          protocol: StreamableHTTP
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: agent-mcp
  namespace: {{ .Namespace }}
  labels:
    app.kubernetes.io/managed-by: agentgateway-demo-wizard
spec:
  parentRefs:
    - name: {{ .GatewayName }}
      namespace: {{ .GatewayNS }}
  rules:
    - matches:
        - path:
            type: PathPrefix
            value: /mcp
      backendRefs:
        - name: agent-mcp-backend
          namespace: {{ .Namespace }}
          group: enterpriseagentgateway.solo.io
          kind: EnterpriseAgentgatewayBackend
---
apiVersion: v1
kind: Secret
metadata:
  name: agent-chat-openai-secret
  namespace: {{ .Namespace }}
  labels:
    app.kubernetes.io/managed-by: agentgateway-demo-wizard
type: Opaque
stringData:
  Authorization: {{ .OpenAIKey }}
---
apiVersion: enterpriseagentgateway.solo.io/v1alpha1
kind: EnterpriseAgentgatewayBackend
metadata:
  name: agent-chat-openai
  namespace: {{ .Namespace }}
  labels:
    app.kubernetes.io/managed-by: agentgateway-demo-wizard
spec:
  ai:
    provider:
      openai:
        model: gpt-4o-mini
  policies:
    auth:
      secretRef:
        name: agent-chat-openai-secret
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: agent-chat
  namespace: {{ .Namespace }}
  labels:
    app.kubernetes.io/managed-by: agentgateway-demo-wizard
spec:
  parentRefs:
    - name: {{ .GatewayName }}
      namespace: {{ .GatewayNS }}
  rules:
    - matches:
        - path:
            type: PathPrefix
            value: /agent-chat
      backendRefs:
        - name: agent-chat-openai
          namespace: {{ .Namespace }}
          group: enterpriseagentgateway.solo.io
          kind: EnterpriseAgentgatewayBackend
