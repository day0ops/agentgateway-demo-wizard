apiVersion: enterpriseagentgateway.solo.io/v1alpha1
kind: EnterpriseAgentgatewayPolicy
metadata:
  name: agent-mcp-tool-access
  namespace: {{ .Namespace }}
  labels:
    app.kubernetes.io/managed-by: agentgateway-demo-wizard
spec:
  targetRefs:
    - group: enterpriseagentgateway.solo.io
      kind: EnterpriseAgentgatewayBackend
      name: agent-mcp-backend
  backend:
    mcp:
      authorization:
        action: Allow
        policy:
          matchExpressions:
            - "jwt['team_id'] == 'team-alpha'"
            - "jwt['team_id'] == 'team-beta' && mcp.tool.target == 'stock'"
