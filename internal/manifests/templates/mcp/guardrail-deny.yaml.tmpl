apiVersion: v1
kind: ServiceAccount
metadata:
  name: mcp-guardrails-deny-stock-server
  namespace: {{ .Namespace }}
  labels:
    app.kubernetes.io/managed-by: agentgateway-demo-wizard
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: mcp-guardrails-deny-stock-server
  namespace: {{ .Namespace }}
  labels:
    app.kubernetes.io/managed-by: agentgateway-demo-wizard
    app: mcp-guardrails-deny-stock-server
spec:
  replicas: 1
  selector:
    matchLabels:
      app: mcp-guardrails-deny-stock-server
  template:
    metadata:
      labels:
        app: mcp-guardrails-deny-stock-server
    spec:
      serviceAccountName: mcp-guardrails-deny-stock-server
      containers:
        - name: server
          image: {{ .StockMCPImage }}
          imagePullPolicy: IfNotPresent
          ports:
            - containerPort: 8000
          resources:
            requests:
              cpu: 100m
              memory: 128Mi
            limits:
              cpu: 200m
              memory: 256Mi
---
apiVersion: v1
kind: Service
metadata:
  name: mcp-guardrails-deny-stock-server
  namespace: {{ .Namespace }}
  labels:
    app.kubernetes.io/managed-by: agentgateway-demo-wizard
spec:
  selector:
    app: mcp-guardrails-deny-stock-server
  ports:
    - port: 80
      targetPort: 8000
      appProtocol: kgateway.dev/mcp
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: mcp-guardrails-deny-guard
  namespace: {{ .Namespace }}
  labels:
    app.kubernetes.io/managed-by: agentgateway-demo-wizard
---
apiVersion: v1
kind: Service
metadata:
  name: mcp-guardrails-deny-guard
  namespace: {{ .Namespace }}
  labels:
    app.kubernetes.io/managed-by: agentgateway-demo-wizard
    app: mcp-guardrails-deny-guard
spec:
  selector:
    app: mcp-guardrails-deny-guard
  ports:
    - port: 4445
      targetPort: 4445
      # ExtMCP is plaintext gRPC (h2c) - agentgateway speaks HTTP/1.1 to this
      # service without this annotation, since port number alone doesn't
      # tell it the backend is actually gRPC.
      appProtocol: kubernetes.io/h2c
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: mcp-guardrails-deny-guard
  namespace: {{ .Namespace }}
  labels:
    app.kubernetes.io/managed-by: agentgateway-demo-wizard
    app: mcp-guardrails-deny-guard
spec:
  replicas: 1
  selector:
    matchLabels:
      app: mcp-guardrails-deny-guard
  template:
    metadata:
      labels:
        app: mcp-guardrails-deny-guard
    spec:
      serviceAccountName: mcp-guardrails-deny-guard
      containers:
        - name: server
          image: {{ .ExtMCPGuardrailImage }}
          imagePullPolicy: IfNotPresent
          ports:
            - containerPort: 4445
          env:
            - name: PORT
              value: "4445"
            - name: DENIED_TOOLS
              value: get_stock_history
          resources:
            requests:
              memory: 64Mi
              cpu: 50m
            limits:
              memory: 128Mi
              cpu: 200m
          readinessProbe:
            tcpSocket:
              port: 4445
            initialDelaySeconds: 3
            periodSeconds: 10
          livenessProbe:
            tcpSocket:
              port: 4445
            initialDelaySeconds: 5
            periodSeconds: 30
---
apiVersion: enterpriseagentgateway.solo.io/v1alpha1
kind: EnterpriseAgentgatewayBackend
metadata:
  name: mcp-guardrails-deny-backend
  namespace: {{ .Namespace }}
  labels:
    app.kubernetes.io/managed-by: agentgateway-demo-wizard
spec:
  mcp:
    targets:
      - name: stock
        static:
          host: mcp-guardrails-deny-stock-server.{{ .Namespace }}.svc.cluster.local
          port: 80
          protocol: StreamableHTTP
          path: /mcp
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: mcp-guardrails-deny
  namespace: {{ .Namespace }}
  labels:
    app.kubernetes.io/managed-by: agentgateway-demo-wizard
spec:
  parentRefs:
    - name: {{ .GatewayName }}
      namespace: {{ .GatewayNS }}
  rules:
    - matches:
        - path:
            type: PathPrefix
            value: /mcp-guardrails/deny
      backendRefs:
        - name: mcp-guardrails-deny-backend
          namespace: {{ .Namespace }}
          group: enterpriseagentgateway.solo.io
          kind: EnterpriseAgentgatewayBackend
---
apiVersion: enterpriseagentgateway.solo.io/v1alpha1
kind: EnterpriseAgentgatewayPolicy
metadata:
  name: mcp-guardrails-deny-policy
  namespace: {{ .Namespace }}
  labels:
    app.kubernetes.io/managed-by: agentgateway-demo-wizard
spec:
  targetRefs:
    - group: enterpriseagentgateway.solo.io
      kind: EnterpriseAgentgatewayBackend
      name: mcp-guardrails-deny-backend
  backend:
    mcp:
      guardrails:
        processors:
          - remote:
              backendRef:
                name: mcp-guardrails-deny-guard
                port: 4445
              failureMode: FailClosed
            methods:
              tools/call: Request
