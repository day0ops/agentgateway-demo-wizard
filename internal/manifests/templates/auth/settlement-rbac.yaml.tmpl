apiVersion: enterpriseagentgateway.solo.io/v1alpha1
kind: EnterpriseAgentgatewayPolicy
metadata:
  name: auth-settlement-rbac
  namespace: {{ .Namespace }}
  labels:
    app.kubernetes.io/managed-by: agentgateway-demo-wizard
spec:
  targetRefs:
    - group: enterpriseagentgateway.solo.io
      kind: EnterpriseAgentgatewayBackend
      name: core-banking-delegation-backend
  backend:
    mcp:
      authorization:
        action: Allow
        policy:
          matchExpressions:
            - "mcp.tool.name == \"transfer\" && jwt.act.act.sub == \"system:serviceaccount:agentgateway-system:transfer-orchestrator-agent\""
